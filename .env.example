# Copy this file to .env and fill in values. Never commit the real .env file.

# --- Hugging Face ---
# Only required if the selected MODEL_ID is gated/private. Qwen2.5-Instruct
# models are public and ungated, so this can usually stay empty.
HUGGINGFACE_TOKEN=

# --- Model ---
# Base instruction model. Must match configs/model.yaml unless overridden here.
MODEL_ID=Qwen/Qwen2.5-7B-Instruct
# Path to a trained LoRA adapter directory (leave empty/unset to run the
# base model only — rupsaa/model/loader.py falls back gracefully and logs
# a warning if this path doesn't exist yet, e.g. before V0.1 is trained).
# Once a V0.1 adapter exists, point this at it, e.g.:
#   RUPSAA_ADAPTER_PATH=adapters/rupsaa-v0.1
# (ADAPTER_PATH also still works, for backward compatibility.)
RUPSAA_ADAPTER_PATH=adapters/rupsaa-v1

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed origins for CORS. Do not use "*" in production.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Owner-only tools (Teach Rupsaa, Rupsaa Knowledge) ---
# See api/owner_routes.py's module docstring for the full security model.
# Unset (empty): /owner/* routes are unprotected, for local development
# only — every request is allowed through, with a warning logged once.
# Set this to a real, random secret before exposing this API beyond
# localhost/a trusted tunnel: once set, every /owner/* request must send a
# matching `X-Owner-Key` header or it gets rejected with 401. Never commit
# a real value here — this file is a template, not your actual .env.
OWNER_API_KEY=

# --- Web UI ---
# Base URL the web chat frontend calls. Must point at the running FastAPI server.
WEB_API_URL=http://localhost:8000

# --- RAG ---
EMBEDDING_MODEL_ID=intfloat/multilingual-e5-small
VECTOR_STORE_DIR=knowledge/index
KNOWLEDGE_DOCS_DIR=knowledge/documents
