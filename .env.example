# Copy to .env and fill in. NEVER commit the real .env (it is git-ignored).
# Everything here has a safe development default; production values are marked PRODUCTION.
# Full guide: docs/PRODUCTION_DEPLOYMENT.md

# --- Environment -------------------------------------------------------------------------
# development (default): lazy model load, no rate limits, owner tools open if OWNER_API_KEY is empty.
# production: refuses to start unless OWNER_API_KEY (>= 24 chars) is set, the adapter exists and
#             CORS is explicit; preloads the model; rate limits on; server paths hidden in /model/info.
RUPSAA_ENV=development
LOG_LEVEL=INFO

# --- Model -------------------------------------------------------------------------------
# Base model: Hugging Face id or a local directory (MODEL_ID also works).
# Current release: Gemma 3 12B IT (gated — accept the Gemma license on Hugging Face and set HUGGINGFACE_TOKEN or run `hf auth login`).
RUPSAA_MODEL_PATH=google/gemma-3-12b-it
# LoRA adapter to attach — switching versions (v0.2.1 -> v0.3, or rolling back) is ONLY this line.
# PRODUCTION: must point at a trained adapter; the server refuses to start otherwise.
RUPSAA_ADAPTER_PATH=adapters/rupsaa-v0.3-gemma3-final
# Expected sha256 of the adapter file(s) — set after a release passes QA to pin the exact
# weights and catch an accidental wrong-adapter swap. Checked by scripts/check_production_config.py.
RUPSAA_ADAPTER_SHA256=3c79e394578261cdb04033867a9d6a96bb20784d5b0fc9d78d20e1b057724f05
# System-prompt version (empty = inferred from the adapter name: rupsaa-v0.2* -> v0.2).
RUPSAA_PROMPT_VERSION=v0.2
# Serving-only identity/style notes appended after the v0.2 persona (default on). 0 = exact trained prompt.
# RUPSAA_SERVING_NOTES=1
# Needed for gated models: google/gemma-3-12b-it is gated (never commit a real token).
HUGGINGFACE_TOKEN=

# --- Servers -----------------------------------------------------------------------------
# PRODUCTION: API_HOST=127.0.0.1 so only the web server (WEB_PORT) is reachable from outside;
# the web server proxies /api/* to the API.
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=5500
# Comma-separated allowed origins; never "*" in production (e.g. https://rupsaa.example.com).
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Owner tools (Teach Rupsaa, Rupsaa Knowledge, reindex) -----------------------------
# Empty = open (development only, warning logged). PRODUCTION: required, random, >= 24 chars,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`. Sent by the owner as the
# X-Owner-Key header (typed into the owner pages); never put it in frontend files.
OWNER_API_KEY=

# --- Limits (defaults shown; development defaults the rate limits to 0 = off) --------------
# Chat requests per minute per client and for the whole server. PRODUCTION default 20 / 120.
RUPSAA_RATE_LIMIT_PER_MINUTE=
RUPSAA_RATE_LIMIT_GLOBAL_PER_MINUTE=
RUPSAA_MAX_REQUEST_BYTES=65536
RUPSAA_MAX_NEW_TOKENS_CAP=1024
RUPSAA_MAX_CONVERSATIONS=5000
RUPSAA_CONVERSATION_IDLE_MINUTES=360
# Load the model at startup (default: yes in production, no in development).
RUPSAA_PRELOAD_MODEL=
# Web proxy -> API timeout in seconds.
RUPSAA_PROXY_TIMEOUT=300

# --- Debugging (leave empty in production) ------------------------------------------------
# Writes every turn INCLUDING user messages and prompts to this JSONL file. Opt-in only.
RUPSAA_TRACE_FILE=

# --- RAG ---------------------------------------------------------------------------------
EMBEDDING_MODEL_ID=intfloat/multilingual-e5-small
VECTOR_STORE_DIR=knowledge/index
KNOWLEDGE_DOCS_DIR=knowledge/documents

# --- Internet + long-term memory ------------------------------------------------------------
# Web look-ups happen ONLY when a user switches "Internet" on for a conversation in the chat UI.
# Internet mode per browser: Ask first (default) / Allow when needed / Never — chosen in the chat header or by saying so.
# Provider: wikipedia (default, no key; encyclopaedic, NOT live prices/news) | brave (needs RUPSAA_BRAVE_API_KEY;
# suitable for current information) | none (web access off server-wide). Only the cleaned question is sent.
RUPSAA_WEB_SEARCH_PROVIDER=wikipedia
# Secret — never commit a real key.
RUPSAA_BRAVE_API_KEY=
RUPSAA_WEB_SEARCH_TIMEOUT=6
# Opt-in long-term memory per browser (Memory button in the chat). Personal data — never commit this folder.
RUPSAA_USER_MEMORY_DIR=data/user_memory
RUPSAA_USER_MEMORY_MAX_FACTS=50
# Durable per-browser internet preference (ASK / ALLOW / DENY). Personal settings — never commit this folder.
RUPSAA_USER_PREFS_DIR=data/user_prefs
# General Knowledge records (curated, versioned in git).
KNOWLEDGE_GENERAL_DIR=knowledge/general

# --- In-chat owner / teacher mode --------------------------------------------------------------
# "I am your teacher" → Rupsaa asks for this secret; the server checks it (constant time, rate-limited). Empty =
# teacher mode off. Use a long random phrase; never commit it, never put it in the frontend.
RUPSAA_TEACH_SECRET=
